    <build>

        <plugins>

            <!-- Compilador Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                </configuration>
            </plugin>


            <!--
                Crea un único JAR con tu aplicación
                + todas sus dependencias.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>

                            <!-- El JAR final reemplaza al JAR normal -->
                            <shadedArtifactAttached>false</shadedArtifactAttached>

                            <!-- Nombre del JAR final -->
                            <finalName>gestor_pacientes-1.0-SNAPSHOT</finalName>

                            <!-- No generar pom reducido -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!--
                                JavaFX y otras librerías pueden traer
                                module-info.class. No queremos esos
                                module-info dentro del fat JAR.
                            -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <!--
                                Configuramos qué clase se ejecuta
                                cuando hacemos java -jar
                            -->
                            <transformers>

                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.pacientes.gestor_pacientes.Principal</mainClass>
                                </transformer>

                                <!-- Necesario para algunas librerías -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                            </transformers>

                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <!-- JavaFX -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>

                <configuration>
                    <mainClass>com.pacientes.gestor_pacientes.Principal</mainClass>
                </configuration>
            </plugin>


            <!-- Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

        </plugins>

    </build>
</project>
